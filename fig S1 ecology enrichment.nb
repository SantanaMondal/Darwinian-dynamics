Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"F1", "[", 
    RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Rho]", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox["u", "\[Kappa]"]}], ")"}]}], "-", 
    FractionBox[
     RowBox[{"\[Delta]", "*", "v"}], 
     RowBox[{"1", "+", 
      RowBox[{"\[Delta]", "*", "\[Gamma]", "*", "u"}]}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Alpha]", "*", "\[Delta]", "*", "u"}], 
     RowBox[{"1", "+", 
      RowBox[{"\[Delta]", "*", "\[Gamma]", "*", "u"}]}]], "-", "\[Mu]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9564730942773037`*^9, 3.956473094611994*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"3bc9f55e-db9a-414c-9b65-cb9842bc3793"],


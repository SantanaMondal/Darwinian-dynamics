Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]", "=", "0.5"}], ";", 
  RowBox[{"\[Kappa]", "=", "150"}], ";", 
  RowBox[{"\[Delta]", "=", "0.15"}], ";", 
  RowBox[{"\[Gamma]", "=", "0.1"}], ";", 
  RowBox[{"\[Alpha]", "=", "0.7"}], ";", 
  RowBox[{"\[Mu]", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"u", "'"}], "[", "t", "]"}], "==", 
        RowBox[{

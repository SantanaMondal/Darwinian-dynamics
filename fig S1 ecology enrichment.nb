         RowBox[{"G", "[", 
          RowBox[{
           RowBox[{"u", "[", "t", "]"}], ",", 
           RowBox[{"v", "[", "t", "]"}]}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"u", "[", "0", "]"}], "\[Equal]", "3"}], ",", 
       RowBox[{
        RowBox[{"v", "[", "0", "]"}], "==", "3"}]}], "}"}], ",", 

          SuperscriptBox["p", "2"], 
          RowBox[{"2", "*", 
           RowBox[{
            SubscriptBox["k", "2"], "^", "2"}]}]]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 

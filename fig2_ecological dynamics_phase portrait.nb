Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]", "=", "0.3"}], ";", 
  RowBox[{"\[Kappa]", "=", "35"}], ";", 
  RowBox[{"\[Delta]", "=", "0.15"}], ";", 
  RowBox[{"\[Gamma]", "=", "0.02"}], ";", 
  RowBox[{"\[Alpha]", "=", "0.7"}], ";", 
  RowBox[{"\[Mu]", "=", "1.1"}], ";", 
  RowBox[{"\[Tau]", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"u", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"u", "[", "t", "]"}], "*", 
         RowBox[{"F1", "[", 
          RowBox[{
           RowBox[{"u", "[", "t", "]"}], ",", 
           RowBox[{"v", "[", "t", "]"}]}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"v", "[", "t", "]"}], "*", 
         RowBox[{"G", "[", 
          RowBox[{
           RowBox[{"u", "[", "t", "]"}], ",", 
           RowBox[{"v", "[", "t", "]"}]}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"u", "[", "0", "]"}], "\[Equal]", "3"}], ",", 
       RowBox[{
        RowBox[{"v", "[", "0", "]"}], "==", "3"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "v"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1000"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol2", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"u", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"u", "[", "t", "]"}], "*", 
         RowBox[{"F2", "[", 
          RowBox[{
           RowBox[{"u", "[", "t", "]"}], ",", 
           RowBox[{"v", "[", "t", "]"}]}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"v", "[", "t", "]"}], "*", 
         RowBox[{"G", "[", 
          RowBox[{
           RowBox[{"u", "[", "t", "]"}], ",", 
           RowBox[{"v", "[", "t", "]"}]}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"u", "[", "0", "]"}], "\[Equal]", "3"}], ",", 
       RowBox[{
        RowBox[{"v", "[", "0", "]"}], "==", "3"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "v"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1000"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"A", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"u", "[", "t", "]"}], ",", 
        RowBox[{"v", "[", "t", "]"}]}], "}"}], "/.", "sol"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "1000"}], "}"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"All", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "All"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"GridLines", "->", "Automatic"}], ",", 

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"F1", "[", 
    RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Rho]", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox["u", "\[Kappa]"]}], ")"}]}], "-", 
    FractionBox[
     RowBox[{"\[Delta]", "*", "v"}], 
     RowBox[{"1", "+", 
      RowBox[{"\[Delta]", "*", "\[Gamma]", "*", "u"}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F2", "[", 
    RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Rho]", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox["u", "\[Kappa]"]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["u", "\[Tau]"], "-", "1"}], ")"}]}], "-", 
    FractionBox[
     RowBox[{"\[Delta]", "*", "v"}], 
     RowBox[{"1", "+", 
      RowBox[{"\[Delta]", "*", "\[Gamma]", "*", "u"}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Alpha]", "*", "\[Delta]", "*", "u"}], 
     RowBox[{"1", "+", 
      RowBox[{"\[Delta]", "*", "\[Gamma]", "*", "u"}]}]], "-", "\[Mu]"}]}], 
  ";"}]}], "Input",

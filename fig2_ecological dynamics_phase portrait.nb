    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Red", ",", "Black"}], "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 

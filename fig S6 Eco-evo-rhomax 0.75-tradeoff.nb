       RowBox[{
        RowBox[{"u", "[", "0", "]"}], "\[Equal]", "3"}], ",", 
       RowBox[{
        RowBox[{"p", "[", "0", "]"}], "\[Equal]", "2"}], ",", 
       RowBox[{
        RowBox[{"v", "[", "0", "]"}], "==", "3"}], ",", 
       RowBox[{
        RowBox[{"q", "[", "0", "]"}], "==", 
        RowBox[{"-", "2"}]}]}], "}"}], ",", 
